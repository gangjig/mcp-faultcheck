{"id": "read-notes", "instruction": "Read notes.txt and confirm the fox sentence is there; report the file size.", "steps": [{"tool": "read_file", "arguments": {"path": "notes.txt"}}], "assertions": [{"type": "result_contains", "value": "quick brown fox"}, {"type": "field_type", "field": "size", "field_type": "integer", "step": 0}]}
{"id": "report-lines", "instruction": "Read report.md, confirm it is the quarterly report and say how many lines it has.", "steps": [{"tool": "read_file", "arguments": {"path": "report.md"}}], "assertions": [{"type": "result_contains", "value": "Quarterly Report"}, {"type": "field_type", "field": "lines", "field_type": "integer", "step": 0}]}
{"id": "count-csv-words", "instruction": "Count the words in data.csv.", "steps": [{"tool": "count_words", "arguments": {"path": "data.csv"}}], "assertions": [{"type": "result_contains", "value": "4"}, {"type": "field_type", "field": "words", "field_type": "integer", "step": 0}]}
{"id": "list-files", "instruction": "List the files and confirm notes.txt exists; report how many files there are.", "steps": [{"tool": "list_files", "arguments": {}}], "assertions": [{"type": "tool_called", "tool": "list_files"}, {"type": "result_contains", "value": "notes.txt"}, {"type": "field_type", "field": "count", "field_type": "integer", "step": 0}]}
{"id": "read-then-count", "instruction": "Read notes.txt, then count its words.", "steps": [{"tool": "read_file", "arguments": {"path": "notes.txt"}}, {"tool": "count_words", "arguments": {"path": "notes.txt"}}], "assertions": [{"type": "result_contains", "value": "quick brown fox"}, {"type": "field_type", "field": "words", "field_type": "integer", "step": 1}, {"type": "max_steps", "value": 2}]}
{"id": "report-outlook", "instruction": "Read report.md and confirm the outlook line; report the file size.", "steps": [{"tool": "read_file", "arguments": {"path": "report.md"}}], "assertions": [{"type": "result_contains", "value": "Outlook is positive"}, {"type": "field_type", "field": "size", "field_type": "integer", "step": 0}]}
